{
  "manifest_version": 3,
  "name": "PageNotes",
  "version": "1.0.0",
  "description": "Webページにメモを作成・表示・編集・削除する機能を提供するChrome拡張機能",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"]
    }
  ],
  "action": {
    "default_title": "PageNotes"
  }
}
